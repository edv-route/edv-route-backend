{
  "name": "edv-route-backend",
  "version": "0.1.0",
  "description": "EDV Route backend API - Fastify + PostgreSQL (Supabase) + PostGIS",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate -m src/db/migrations up && npm run db:types",
    "migrate:down": "node-pg-migrate -m src/db/migrations down && npm run db:types",
    "migrate:create": "node-pg-migrate -m src/db/migrations create",
    "seed:admin": "tsx src/db/seed-admin.ts",
    "db:types": "kanel"
  },
  "keywords": [
    "fastify",
    "postgresql",
    "postgis",
    "supabase"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/jwt": "^10.2.0",
    "@fastify/sensible": "^6.0.4",
    "argon2": "^0.44.0",
    "dotenv": "^17.4.2",
    "env-schema": "^7.0.0",
    "fastify": "^5.10.0",
    "fastify-plugin": "^6.0.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "kanel": "^4.0.2",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
