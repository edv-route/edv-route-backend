# Runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:4200

# Supabase Postgres connection string.
# Get it from: Supabase Dashboard > Project Settings > Database > Connection string.
# Use the "Session pooler" URI (port 5432) for local development on IPv4 networks.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Auth (admin JWT). Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_EXPIRES_IN=8h

# File storage (Supabase Storage). Optional: without them the app boots but
# uploads/downloads return 503. Get the service-role key from:
# Supabase Dashboard > Project Settings > API > service_role secret.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
STORAGE_BUCKET=documents

# Firebase Cloud Messaging (push). Optional: without these three the dispatcher
# keeps the log-only sender and nothing ever leaves the building.
# Get them from: Firebase Console > Project settings > Service accounts >
# Generate new private key. The private key goes on ONE line with literal \n.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# Connections THIS instance may hold. 0 = pick by environment (prod 8, dev 3).
# Supabase's session pooler caps the whole project at 15 clients and prod and dev
# share one database, so the sum has to fit: prod 8 + laptop 3 + a test run 2..4.
# Raise the ceiling first (Supabase > Settings > Database > Connection pooling),
# then raise this.
DATABASE_POOL_MAX=0

# Transactional email (Resend) - password recovery for the driver app.
# Optional like storage and Firebase: without them the API boots with a log-only
# sender and the recovery endpoints answer 503 instead of promising a code that
# never leaves. EMAIL_FROM must be an address on a domain VERIFIED in Resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="EDV Route <no-responder@tu-dominio.com>"

# SMTP - LOCAL ONLY. Railway blocks outbound SMTP (25/465/587) below the Pro
# plan, verified 2026-08-24: these very credentials authenticate from a laptop
# and time out from Railway. Do NOT set these in production - the backend would
# believe mail is configured and tell drivers to "try again in a few minutes"
# forever. Production waits for a domain, then Resend (HTTPS, never blocked).
#
# SMTP - the fallback while there is no domain of our own. Every ESP refuses to
# send to arbitrary recipients from an unverified domain, so today the mail goes
# through Gmail: sent from Google's own servers, signed by Google, it actually
# reaches the inbox. An ESP relaying "on behalf of" a @gmail.com address fails
# DKIM alignment and lands in spam - which for a recovery code means never sent.
# SMTP_PASSWORD is a Google APP PASSWORD (16 chars, needs 2-step verification
# on the account), never the account's real password. Resend wins if both are set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=edvroute@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
